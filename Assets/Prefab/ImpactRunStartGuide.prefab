  titleText: "Impact Run \u64CD\u4F5C\u8AAC\u660E"
  commentText: "\u30B4\u30FC\u30EB\u307E\u3067\u306E\uFF11\uFF15\uFF10\uFF4D\u306E\u9593\u3001\u6575\u3092\u5012\u3057\u3066\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u305F\u3081\u3064\u3064\u99C6\u3051\u629C\u3051\u308B\u3002\n\u9053\u306B\u843D\u3061\u305F\u308A\u6575\u306B\u3076\u3064\u304B\u308B\u3068\u3001\u5DE6\u4E0A\u306E\uFF28\uFF30\uFF15\uFF10\u304C\u6E1B\u3063\u305F\u72B6\u614B\u3067\u30ED\u30DC\u6226\u306B\u306A\u308B\u3002"
  operationText: "\u5DE6\u30B9\u30C6\u30A3\u30C3\u30AF / \u5341\u5B57\u30AD\u30FC\uFF1A\u79FB\u52D5\nA
