  lines:
  - speakerName: "\u306F\u3050\u308B\u307E\u3000\u3081\u3050\u308B"
    portrait: {fileID: 21300000, guid: c4964c13d5654a9429d017f3f079cf97, type: 3}
    voice: {fileID: 0}
    voiceVolume: 1
    text: "\u3042\u3063\uFF01\u305D\u3053\u306E\u4EBA\u3001\u79C1\u306E\u304A\u59C9\u3061\u3083\u3093\u77E5\u3089\u306A\u3044\uFF1F\u79C1\u3068\u540C\u3058\u30ED\u30FC\u30D6\u3092\u6765\u305F\u767D\u3044\u9AEA\u306E\u5B50\u3002"
  - speakerName: "\uFF11\u9762\u306E\u30DC\u30B9"
    portrait: {fileID: 21300000, guid: de8dff8e03809d04c94b86cae4b16b80, type: 3}
    voice: {fileID: 0}
    voiceVolume: 1
    text: "\u3048\uFF1F\u306A\u306B\uFF1F\u79C1\u3001\u304A\u8179\u3059\u3044\u3066\u30A4\u30E9\u30A4\u30E9\u3057\u3066\u308B\u3093\u3060\u3051\u3069"
  - speakerName: "\u306A\u305E\u306E\u3042\u3093\u3093\u3069\u308D\u3044\u3069"
    portrait: {fileID: 21300000, guid: 1a40e1047f4cfa149adddc2fcf99a59c, type: 3}
    voice: {fileID: 0}
    voiceVolume: 1
    text: "\u3081\u3050\u308B\u3001\u306A\u3093\u304B\u3053\u306E\u4EBA\u3001\u5371\u306A\u3044\u5302\u3044\u304C\u3059\u308B\u3088\u3002"
  - speakerName: "\u306F\u3050\u308B\u307E\u3000\u3081\u3050\u308B"
    portrait: {fileID: 21300000, guid: c4964c13d5654a9429d017f3f079cf97, type: 3}
    voice: {fileID: 0}
    voiceVolume: 1
    text: "\u305D\u3046\uFF1F\u5927\u4E08\u592B\u3060\u3051\u3069\u3001\u77E5\u3063\u3066\u3089\u6559\u3048\u3066"
  - speakerName: "1\u9762\u306E\u30DC\u30B9"
    portrait: {fileID: 21300000, guid: de8dff8e03809d04c94b86cae4b16b80, type: 3}
    voice: {fileID: 0}
    voiceVolume: 1
    text: "\u79C1\u306E\u98DF\u4E8B\u304C\u7D42\u308F\u3063\u305F\u3089\u6559\u3048\u3066\u3084\u308B\u3088\uFF01\u304A\u3068\u306A\u3057\u304F\u98DF\u308F\u308C\u306A\uFF01"
  - speakerName: "\u306A\u305E\u306E\u3042\u3093\u3093\u3069\u308D\u3044\u3069"
