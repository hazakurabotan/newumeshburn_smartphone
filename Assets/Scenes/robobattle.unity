  m_Script: {fileID: 11500000, guid: 6a7d45433aaf2074b8d56e3b8f2924cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  guidePanelRoot: {fileID: 1306329937}
  autoCreatePanelIfMissing: 1
  autoCreateContents: 1
  controllerSprite: {fileID: 0}
  titleText: "\u30ED\u30DC\u30D0\u30C8\u30EB \u64CD\u4F5C\u8AAC\u660E"
  commentText: "\u53F3\u4E0A\u306F\u3001\u30DC\u30B9\u306E\u4F53\u529B\u3002\u5DE6\u5074\u306B\u306F\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u4F53\u529B\u3068\u3001\u5F3E\u306E\u6B8B\u5F3E\u3002\n\u5F3E\u306F\u6642\u9593\u304C\u7D4C\u3064\u3068\u56DE\u5FA9\u3057\u307E\u3059\u3002\n\u30DF\u30B5\u30A4\u30EB\u306F\u6483\u3061\u843D\u3059\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\n\u30D1\u30F3\u30C1\u306F\u30DC\u30B9\u304C\u63A5\u8FD1\u3057\u305F\u6642\u306B\u30D1\u30F3\u30C1\u3067\u6483\u9000\u3059\u308B\u3068\u304D\u306E\u307F\u4F7F\u3044\u307E\u3059\u3002"
  operationText: "\u30B8\u30E7\u30A4\u30D1\u30C3\u30C9\u30FB\u65B9\u5411\u30AD\u30FC\uFF1A\u5F3E\u306E\u30AB\u30FC\u30BD\u30EB\u79FB\u52D5\nSouth\uFF08A\uFF09\u30DC\u30BF\u30F3\uFF1A\u5F3E\u3092\u3046\u3064\nWest\uFF08X\uFF09\u30DC\u30BF\u30F3\uFF1A\u5DE6\u30D1\u30F3\u30C1\nEast\uFF08B\uFF09\u30DC\u30BF\u30F3\uFF1A\u53F3\u30D1\u30F3\u30C1\nLeft\u30C8\u30EA\u30AC\u30FC\uFF1A\u5DE6\u30AC\u30FC\u30C9\nRight\u30C8\u30EA\u30AC\u30FC\uFF1A\u53F3\u30AC\u30FC\u30C9"
  holdGuideText: "South\u30DC\u30BF\u30F3\u9577\u62BC\u3057\u3067\u30B9\u30BF\u30FC\u30C8"
  controllerImage: {fileID: 1314058520}
