--- !u!114 &421121883
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 421121881}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7cd59639a6ff8ed428c0c3088d88f1eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bgImage: {fileID: 1730878325}
  dialogPanelImage: {fileID: 519407445}
  bodyText: {fileID: 1242507503}
  voiceSource: {fileID: 0}
  lines:
  - text: "\u3053\u308C\u306F\u3075\u305F\u308A\u306E\u5C11\u5973\u304C\u4E16\u754C\u3092\u6551\u3046\u7269\u8A9E\u3002"
    background: {fileID: 21300000, guid: 4da6f86cfca9ac245a0033ebd29f6c58, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 8300000, guid: 5379101f004ca68408cee1893f90e2a1, type: 3}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u4E16\u754C\u306F\u30C7\u30B9\u30C8\u30ED\u30A4\u3046\u3081\u3057\u3070\u306E\u624B\u306B\u3088\u3063\u3066\u79E9\u5E8F\u304C\u3053\u308F\u3055\u308C\u3088\u3046\u3068\u3057\u3066\u3044\u308B"
    background: {fileID: 21300000, guid: 4da6f86cfca9ac245a0033ebd29f6c58, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 8300000, guid: a74d0ba6180898048896a3b85df10779, type: 3}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u3081\u3050\u308B\u305F\u3061\u306E\u4F4F\u3080\u8857\u3082\u4F8B\u5916\u3067\u306F\u306A\u304B\u3063\u305F"
    background: {fileID: 21300000, guid: 4da6f86cfca9ac245a0033ebd29f6c58, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0
    autoAdvanceOnVoiceEnd: 0
  - text: "\u304A\u59C9\u3061\u3083\u3093\u304A\u304B\u3048\u308A\uFF01\u8857\u306E\u30D1\u30C8\u30ED\u30FC\u30EB\u304A\u3064\u304B\u308C\u3055\u307E"
    background: {fileID: 21300000, guid: 4da6f86cfca9ac245a0033ebd29f6c58, type: 3}
    dialogPanel: {fileID: 21300000, guid: 29787b93a5f0c6341a05c13c4ad8c158, type: 3}
    voice: {fileID: 8300000, guid: 7fbb51409ca29424bbd0d2c946e5dbde, type: 3}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u3081\u308B\u3050\u308B\u305F\u3060\u3044\u307E\uFF01\u3042\u308A\u304C\u3068\u3046\u306D\u3002\u7121\u4E8B\u306B\u304B\u3048\u3063\u3066\u304D\u305F\u3088"
    background: {fileID: 21300000, guid: 4da6f86cfca9ac245a0033ebd29f6c58, type: 3}
    dialogPanel: {fileID: 21300000, guid: 57c4daae84a84384aad813a58253b542, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0
    autoAdvanceOnVoiceEnd: 0
  - text: "\u304A\u7559\u5B88\u756A\u4E2D\u306B\u4F55\u304B\u304B\u308F\u3063\u305F\u4E8B\u306F\u306A\u304B\u3063\u305F\uFF1F\u3060\u3044\u3058\u3087\u3046\u3076\u3060\u3063\u305F\uFF1F"
    background: {fileID: 21300000, guid: 4da6f86cfca9ac245a0033ebd29f6c58, type: 3}
    dialogPanel: {fileID: 21300000, guid: 57c4daae84a84384aad813a58253b542, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0
    autoAdvanceOnVoiceEnd: 0
  - text: "\u3060\u3044\u3058\u3087\u3046\u3076\u3060\u3088\u3002\u306A\u306B\u3082\u306A\u304B\u3063\u305F\u3088\u3002\u305D\u308C\u3088\u308A\u304A\u59C9\u3061\u3083\u3093\u3053\u3053\u3092\u6559\u3048\u3066"
    background: {fileID: 21300000, guid: 4da6f86cfca9ac245a0033ebd29f6c58, type: 3}
    dialogPanel: {fileID: 21300000, guid: 29787b93a5f0c6341a05c13c4ad8c158, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0
    autoAdvanceOnVoiceEnd: 0
  - text: "\u3044\u3044\u3088\u3002\u3069\u3053\u304C\u308F\u304B\u3089\u306A\u3044\u306E\uFF1F\u304A\u59C9\u3061\u3083\u3093\u304C\u6559\u3048\u3066\u3042\u3052\u308B"
    background: {fileID: 21300000, guid: 4da6f86cfca9ac245a0033ebd29f6c58, type: 3}
    dialogPanel: {fileID: 21300000, guid: 57c4daae84a84384aad813a58253b542, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u6B6F\u8ECA\u3064\u304F\u308B\u306F\u3001\u3044\u3082\u3046\u3068\u306E\u3081\u3050\u308B\u3068\u751F\u307E\u308C\u80B2\u3063\u305F\u8857\u3092\u5B88\u308B\u305F\u3081\u306B\u3001"
    background: {fileID: 21300000, guid: 3f6cb207597808645bf27431f1324cb5, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 8300000, guid: b4ab151cb1a215441a3d9a3c14712e2b, type: 3}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u81EA\u8EAB\u306E\u4F5C\u3063\u305F\u30A2\u30FC\u30E0\u30AE\u30A2\u3092\u305D\u3046\u3073\u3057\u3001\u8857\u306B\u305B\u307E\u308B\u3046\u3081\u3057\u3070\u306E\u306A\u304B\u307E\u3092\u3052\u304D\u305F\u3044\u3057\u305F\u3002"
    background: {fileID: 21300000, guid: 3f6cb207597808645bf27431f1324cb5, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0
    autoAdvanceOnVoiceEnd: 0
  - text: "\u304A\u59C9\u3061\u3083\u3093\u3001\u3046\u3081\u3057\u3070\u306A\u3093\u3066\u65E9\u304F\u305F\u304A\u3057\u3066\u304D\u3066\u306D"
    background: {fileID: 21300000, guid: 3f6cb207597808645bf27431f1324cb5, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u306F\u3044\u3088\u3002\u307E\u304B\u305B\u3066\uFF01\u304A\u59C9\u3061\u3083\u3093\u304C\u305F\u304A\u3057\u3066\u304F\u308B\u3088\u3002\u3053\u306E\u8857\u306F\u3081\u3050\u308B\u306B\u307E\u304B\u305B\u305F\u3002\u624B\u7D19\u304B\u304F\u306D"
    background: {fileID: 21300000, guid: 3f6cb207597808645bf27431f1324cb5, type: 3}
    dialogPanel: {fileID: 21300000, guid: 29787b93a5f0c6341a05c13c4ad8c158, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u59C9\u306E\u3064\u304F\u308B\u304C\u305F\u3073\u306B\u3067\u3066\u3001\u3057\u3070\u3089\u304F\u3057\u3066\u624B\u7D19\u304C\u3068\u3069\u304B\u306A\u304F\u306A\u3063\u305F"
    background: {fileID: 21300000, guid: 48fce4eb3b9fdee4a928ca0a99dab9fd, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u59C9\u304B\u3089\u3055\u3044\u3054\u306E\u3066\u304C\u307F\u306F\u3001\u30C7\u30B9\u30C8\u30ED\u30A4\u3046\u3081\u3057\u3070\u306E\u3057\u308D\u306B\u3064\u3044\u305F\u3068\u3044\u3046\u306A\u3044\u3088\u3046\u3060\u3063\u305F"
    background: {fileID: 21300000, guid: 48fce4eb3b9fdee4a928ca0a99dab9fd, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u304A\u59C9\u3061\u3083\u3093\u3001\u5927\u4E08\u592B\u304B\u306A\uFF1F\u3082\u3046\u3042\u308C\u304B\u3089\u5168\u7136\u624B\u7D19\u304C\u6765\u3066\u3044\u306A\u3044\u3002"
    background: {fileID: 21300000, guid: 48fce4eb3b9fdee4a928ca0a99dab9fd, type: 3}
    dialogPanel: {fileID: 21300000, guid: 29787b93a5f0c6341a05c13c4ad8c158, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u304A\u59C9\u3061\u3083\u3093\u306B\u4F55\u304B\u304C\u3042\u3063\u305F\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u304A\u59C9\u3061\u3083\u3093\u3092\u307E\u3063\u3066\u3066\uFF01"
    background: {fileID: 21300000, guid: 48fce4eb3b9fdee4a928ca0a99dab9fd, type: 3}
    dialogPanel: {fileID: 21300000, guid: 29787b93a5f0c6341a05c13c4ad8c158, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  - text: "\u3053\u3046\u3057\u3066\u3001\u3081\u3050\u308B\u306F\u59C9\u3092\u3055\u304C\u3059\u305F\u3073\u306B\u3067\u308B\u3053\u3068\u306B\u306A\u3063\u305F\u3002"
    background: {fileID: 21300000, guid: 48fce4eb3b9fdee4a928ca0a99dab9fd, type: 3}
    dialogPanel: {fileID: 21300000, guid: b72550906963111489544e44cca0198b, type: 3}
    voice: {fileID: 0}
    voiceVolume: 0.5
    autoAdvanceOnVoiceEnd: 0
  nextSceneName: CharacterSelect
